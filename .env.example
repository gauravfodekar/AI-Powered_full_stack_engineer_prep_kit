# ==============================================================================
# AI-Powered Full-Stack Interview Preparation Kit Generator - Backend Config
# ==============================================================================

# Server Port
PORT=4000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Google Gemini API Key (Required for live AI generation)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini Model Identifier (Default: gemini-3.5-flash-lite)
# Automatic fallback chain supported: gemini-3.5-flash-lite -> gemini-2.5-flash -> gemini-1.5-flash -> gemini-3.7-flash -> gemini-2.5-pro
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/interview_prep_kit

# JSON Web Token (JWT) Secret for user session signing
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# SSRF Security Override (Set to true only for local test suites / mock servers)
ALLOW_LOCAL_URLS=false

# Maximum number of internal sub-pages crawled per company URL (1-20)
MAX_CRAWL_PAGES=5

# HTTP Crawler timeout per page in milliseconds (1000 - 30000)
CRAWL_TIMEOUT_MS=8000

